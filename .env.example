# RevenueCat: use the PUBLIC SDK/Test Store key during development.
# The provided test_ZFB... key can be used as EXPO_PUBLIC_RC_KEY for a Test Store build.
EXPO_PUBLIC_RC_KEY=test_your_revenuecat_public_or_test_store_key

# Optional real platform-specific keys for release builds.
EXPO_PUBLIC_RC_IOS=appl_your_public_ios_key
EXPO_PUBLIC_RC_ANDROID=goog_your_public_android_key

# Optional. Receipt images are sent to OpenAI Vision for extraction.
EXPO_PUBLIC_OPENAI_KEY=sk-your-openai-key

# Optional analytics.
EXPO_PUBLIC_POSTHOG_KEY=phc-your-posthog-key
